{
  "name": "lettering-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do jogo educacional Lettering",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.js",
    "migrate": "ts-node src/scripts/migrate.ts",
    "migrations": "npm run migrate",
    "migrate:production": "node dist/scripts/migrate.js",
    "seed:rankings": "ts-node src/scripts/seedRankings.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
